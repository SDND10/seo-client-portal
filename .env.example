# Neon Postgres connection string (from your Neon dashboard -> Connect)
DATABASE_URL=postgres://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Random secret used to sign login session cookies (run: openssl rand -hex 32)
SESSION_SECRET=change-me-to-a-long-random-string

# API key your Grok bot must send as "Authorization: Bearer <key>" to /api/ingest
# (run: openssl rand -hex 32)
INGEST_API_KEY=change-me-to-another-long-random-string

# Master (admin) login created by `npm run db:setup`
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me
ADMIN_NAME=Shane
